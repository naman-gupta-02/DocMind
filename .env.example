# --- Core ---
NODE_ENV=development
PORT=4000

# --- MongoDB ---
# Works against either a local mongod (no setup needed) or a real Atlas cluster (free M0 tier
# supports Vector Search). Hybrid search auto-detects which one it's talking to — see README.
# For a real Atlas cluster, see infra/atlas/README.md for index setup.
MONGODB_URI=mongodb://127.0.0.1:27017/docmind

# --- Redis (job queue + caching + job-status hashes + pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=changeme-in-production

# --- LLM / Embeddings / Generation ---
# Embeddings always use Gemini (EMBEDDING_PROVIDER has no other option yet). Generation
# (LLM_PROVIDER) can be:
#   - gemini: needs GEMINI_API_KEY with a Google Cloud project that has generation quota
#     (embeddings and generation are billed/quota'd separately — a key that embeds fine may
#     still have 0 generation quota on the free tier).
#   - ollama: free and unlimited via a local Ollama server (https://ollama.com) — no API key,
#     just `ollama pull llama3.2` and make sure `ollama serve` is running.
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_RERANK_MODEL=gemini-2.0-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Reranking always uses Gemini regardless of LLM_PROVIDER (a cheap flash-lite call) — set false
# if you don't have Gemini generation quota; it already fails open to the RRF order either way.
RERANK_ENABLED=true

# --- Retrieval ---
RETRIEVAL_TOP_K=6
# 0.7 is a common rule of thumb but not universal — it's tuned per embedding model. Empirically,
# gemini-embedding-001 scores relevant question/passage pairs ~0.55-0.70 and irrelevant ones
# ~0.45-0.50, so 0.55 is a better floor for this model than the textbook 0.7.
SIMILARITY_THRESHOLD=0.55

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Reconciliation ---
JOB_STALE_TTL_MINUTES=15
RECONCILIATION_INTERVAL_MINUTES=5
